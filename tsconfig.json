{
  "compilerOptions": {
    "target": "es2022",
    "allowJs": false,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "noEmit": false,
    "strict": true,
    "module": "node16",
    "moduleResolution": "node16",
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/editor/*"
  ]
}
